@page "/admin/close"
@inject HttpClient Http
@inject AuthService Auth
@implements IDisposable

<PageTitle>Закрытие времени</PageTitle>
<h1>Закрытие времени</h1>

@if (Auth.Role != "Admin")
{
    <p>Нет доступа. Войдите как администратор.</p>
}
else
{
    <div class="card mb-3" style="max-width:820px">
        <div class="card-body">
            <h5 class="card-title">Закрыть время</h5>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <input type="date" class="form-control" style="max-width:170px"
                       value="@date.ToString("yyyy-MM-dd")" @onchange="DateChanged" />
                <span>с</span>
                <TimeBox @bind-Value="closeStart" />
                <span>по</span>
                <TimeBox @bind-Value="closeEnd" />
                <input class="form-control" style="max-width:240px" list="close-reasons"
                       placeholder="Причина" @bind="closeReason" />
                <button class="btn btn-secondary" @onclick="CloseTime">Закрыть</button>
            </div>

            @* подсказки причины: можно выбрать или написать свою *@
            <datalist id="close-reasons">
                <option value="Совещание"></option>
                <option value="Педсовет"></option>
                <option value="Технический перерыв"></option>
                <option value="Учебная часть не работает"></option>
            </datalist>

            <small class="text-muted">Весь день: 08:00 — 16:30. Записи студентов из закрытого времени перенесутся сами.</small>
        </div>
    </div>

    @if (message != null)
    {
        <div class="eq-toast">@message</div>
    }

    @* ---- Закрытое время на день ---- *@
    <h5>Закрытое время</h5>
    @if (closures == null || closures.Count == 0)
    {
        <p class="text-muted">Закрытого времени нет</p>
    }
    else
    {
        <ul class="list-group mb-3" style="max-width:620px">
            @foreach (var c in closures)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@c.Start.ToString("HH:mm")–@c.End.ToString("HH:mm"): @c.Reason</span>
                    <button class="btn btn-sm btn-outline-success" @onclick="() => OpenTime(c.Id)">Открыть</button>
                </li>
            }
        </ul>
    }

    <DayTable Items="bookings" />
}

@code {
    private record ClosureDto(int Id, TimeOnly Start, TimeOnly End, string Reason);

    private DateOnly date = DateOnly.FromDateTime(DateTime.Now);
    private TimeOnly closeStart = new TimeOnly(10, 0);
    private TimeOnly closeEnd = new TimeOnly(11, 0);
    private string closeReason = "";

    private List<AdminBookingDto>? bookings;
    private List<ClosureDto>? closures;
    private string? message;

    private System.Threading.Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.Role != "Admin")
            return;

        await Load();
        // раз в 5 секунд тихо обновлять
        timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                try
                {
                    await Load();
                    StateHasChanged();
                }
                catch (HttpRequestException)
                {
                    // нет связи — шапка уже показала плашку; попробуем через 5 секунд
                }
            });
        }, null, 5000, 5000);
    }

    // ушли со страницы — остановить таймер
    public void Dispose() => timer?.Dispose();

    private async Task Load()
    {
        bookings = await Http.GetFromJsonAsync<List<AdminBookingDto>>($"api/admin/day?date={date:yyyy-MM-dd}");
        closures = await Http.GetFromJsonAsync<List<ClosureDto>>($"api/closures/mine?date={date:yyyy-MM-dd}");
    }

    private async Task DateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
        {
            date = d;
            await Load();
        }
    }

    private async Task CloseTime()
    {
        var resp = await Http.PostAsJsonAsync("api/closures", new
        {
            date = date.ToString("yyyy-MM-dd"),
            start = closeStart.ToString("HH:mm:ss"),
            end = closeEnd.ToString("HH:mm:ss"),
            reason = closeReason
        });
        Say(await resp.Content.ReadAsStringAsync());
        await Load();
    }

    private async Task OpenTime(int id)
    {
        var resp = await Http.DeleteAsync($"api/closures/{id}");
        Say(await resp.Content.ReadAsStringAsync());
        await Load();
    }

    // показать сообщение и убрать через 5 секунд (длинное сообщение о переносе — через 10)
    private void Say(string text)
    {
        message = text;
        _ = HideLater(text);
    }

    private async Task HideLater(string text)
    {
        await Task.Delay(text.Length > 120 ? 10000 : 5000);
        if (message == text)
        {
            message = null;
            StateHasChanged();
        }
    }
}