@page "/profile"
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Профиль</PageTitle>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3" style="max-width:820px">
    <h1 class="mb-0">Профиль</h1>
    @if (Auth.IsLoggedIn)
    {
        <button class="btn eq-btn eq-btn-green" @onclick="Logout">Выйти</button>
    }
</div>

@if (!Auth.IsLoggedIn)
{
    <p>Сначала войдите.</p>
}
else if (profile == null)
{
    <p>Загрузка...</p>
}
else
{
    <div class="eq-profile">
        @* ---- Разделы слева (на телефоне — сверху) ---- *@
        <nav class="eq-side">
            @if (profile.Role == "Student")
            {
                <button class="@(tab == "bookings" ? "active" : "")" @onclick='() => Open("bookings")'>Мои записи</button>
            }
            <button class="@(tab == "data" ? "active" : "")" @onclick='() => Open("data")'>Мои данные</button>
            <button class="@(tab == "settings" ? "active" : "")" @onclick='() => Open("settings")'>Настройки аккаунта</button>
        </nav>

        <div class="eq-side-body">
            @if (message != null)
            {
                <div class="alert @(ok ? "alert-success" : "alert-danger")">@message</div>
            }

            @* ---- Мои записи (студент) ---- *@
            @if (tab == "bookings" && myBookings != null)
            {
                <h5>Мои записи</h5>
                @if (myBookings.Count == 0)
                {
                    <p class="mb-2">Записей нет.</p>
                    <a class="btn eq-btn eq-btn-blue" href="">Записаться</a>
                }
                @foreach (var b in myBookings)
                {
                    <div class="eq-row">
                        <span>
                            @if (!b.CanCancel)
                            {
                                <b>Вызов: </b>
                            }
                            @b.Text
                        </span>
                        @if (b.CanCancel)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelBooking(b.Id)">Отменить</button>
                        }
                    </div>
                }
            }

            @* ---- Мои данные ---- *@
            @if (tab == "data")
            {
                <h5>Мои данные</h5>

                @if (profile.Role == "Admin")
                {
                    <div class="eq-row"><span class="text-muted">Учётная запись</span><span>@profile.Login</span></div>
                    <div class="eq-row"><span class="text-muted">Название</span><span>@profile.FullName</span></div>
                    <div class="eq-row"><span class="text-muted">Корпус</span><span>@profile.Office</span></div>
                }
                else
                {
                    @if (profile.Status == "Rejected")
                    {
                        <div class="alert alert-danger py-2">Учётная запись не подтверждена: @profile.RejectReason. Исправьте данные — они снова уйдут на проверку.</div>
                    }
                    @if (profile.PendingFullName != null || profile.PendingGroup != null || profile.PendingOfficeId != null)
                    {
                        <div class="alert alert-warning py-2">
                            На проверке изменение: @profile.PendingFullName, группа @profile.PendingGroup,
                            @(profile.PendingOffice ?? profile.Office)@(profile.PendingReason != null ? $" (причина: {profile.PendingReason})" : "").
                            Пока действуют прежние данные.
                        </div>
                    }

                    @if (!editing)
                    {
                        <div class="eq-row"><span class="text-muted">Номер студенческого</span><span>@profile.Login</span></div>
                        <div class="eq-row"><span class="text-muted">ФИО</span><span>@profile.FullName</span></div>
                        <div class="eq-row"><span class="text-muted">Группа</span><span>@profile.Group</span></div>
                        <div class="eq-row"><span class="text-muted">Корпус</span><span>@(profile.Office ?? "не указан")</span></div>
                        <div class="eq-row"><span class="text-muted">Статус</span><span>@StatusText(profile.Status)</span></div>
                        @if (profile.DataBlock != null)
                        {
                            <div class="alert alert-danger py-2 mt-3 mb-0">@profile.DataBlock.</div>
                        }
                        @if (profile.DataLocked)
                        {
                            <div class="small text-muted mt-3">Данные берутся из списка техникума. Если они неверны, обратитесь в учебную часть.</div>
                        }
                        else
                        {
                            <button class="btn eq-btn eq-btn-blue mt-3" @onclick="StartEdit">Изменить</button>
                        }

                        @* ---- Доступ к записи: так студент видит порядочность (без слов «уровень» и «рейтинг») ---- *@
                        <h5 class="mt-4">Доступ к записи</h5>
                        <div class="eq-access" title="Чем больше нарушений, тем строже доступ">
                            @for (var i = 0; i <= 6; i++)
                            {
                                <span class="@(i <= profile.Access ? $"eq-lvl-{profile.Access}" : "")"></span>
                            }
                        </div>
                        <div class="mt-2"><LevelDot Level="profile.Access" /><b>@Capital(profile.AccessName)</b></div>
                        @foreach (var w in profile.Warnings)
                        {
                            <div class="alert alert-warning eq-warn py-2 mt-2 mb-0"><b>⚠ Предупреждение.</b> @w</div>
                        }
                        @if (profile.Punishment != null)
                        {
                            <div class="alert alert-danger py-2 mt-2 mb-0">Сейчас @profile.Punishment.</div>
                        }
                        @if (profile.NextDrop != null)
                        {
                            <div class="small text-muted mt-2">Если не будет нарушений, доступ станет свободнее @profile.NextDrop.Value.ToString("dd.MM.yyyy").</div>
                        }
                        <div class="small text-muted mt-2">
                            Неявки, отмена позже чем за 30 минут, слишком частые записи и отмены или заявки на изменение данных
                            ограничивают доступ к записи. Чем больше нарушений, тем строже и дольше ограничения.
                            Без нарушений доступ постепенно возвращается.
                        </div>
                    }
                    else
                    {
                        @* подсказки причины: можно выбрать или написать свою *@
                        <datalist id="change-reasons">
                            <option value="Перевод"></option>
                            <option value="Ошибка при регистрации"></option>
                        </datalist>

                        <div class="eq-enter" style="max-width:420px">
                            <StudentFields Form="form" ShowOffice="true" />
                            @if (profile.Status == "Approved")
                            {
                                @* подтверждённому изменения проверяет учебная часть — нужна причина *@
                                <input class="form-control mb-2" list="change-reasons" placeholder="Причина изменения"
                                       @bind="form.Reason" />
                                <div class="form-text mt-0 mb-2">При смене корпуса заявку проверит учебная часть нового корпуса</div>
                            }
                            <div class="d-flex gap-2 mt-2">
                                <button class="btn btn-primary eq-submit" @onclick="SaveData">Сохранить</button>
                                <button class="btn btn-outline-secondary" @onclick="() => editing = false">Отмена</button>
                            </div>
                        </div>
                    }
                }
            }

            @* ---- Настройки аккаунта ---- *@
            @if (tab == "settings")
            {
                @* ---- Почта ---- *@
                <h5>Почта</h5>
                <div style="max-width:420px">
                    <div class="eq-row">
                        <span class="text-muted">Привязана</span>
                        <span>
                            @(profile.Email == null ? "нет" : showEmail ? profile.EmailFull : profile.Email)
                            @if (profile.Email != null)
                            {
                                @* глазик: полный адрес / скрытый *@
                                <button type="button" class="eq-eye-inline" title="@(showEmail ? "Скрыть" : "Показать полностью")"
                                        @onclick="() => showEmail = !showEmail">
                                    @(showEmail ? "🙈" : "👁")
                                </button>
                            }
                        </span>
                    </div>
                   
                    @if (profile.Email != null && !changingEmail)
                    {
                        <button class="btn btn-outline-primary btn-sm mt-2" @onclick="() => changingEmail = true">Сменить почту</button>
                    }
                    else
                    {
                        <div class="mt-2"><ContactBind NeedPassword="profile.Email != null" OnDone="EmailDone" /></div>
                    }
                </div>

                @* ---- Телефон (только если SMS включены на сервере) ---- *@
                @if (Auth.SmsEnabled && profile.Role == "Student")
                {
                    <h5 class="mt-4">Телефон</h5>
                    <div style="max-width:420px">
                        <div class="eq-row">
                            <span class="text-muted">Привязан</span>
                            <span>
                                @(profile.Phone == null ? "нет" : showPhone ? profile.PhoneFull : profile.Phone)
                                @if (profile.Phone != null)
                                {
                                    <button type="button" class="eq-eye-inline" title="@(showPhone ? "Скрыть" : "Показать полностью")"
                                            @onclick="() => showPhone = !showPhone">
                                        @(showPhone ? "🙈" : "👁")
                                    </button>
                                }
                            </span>
                        </div>
                        @if (profile.Phone != null && !changingPhone)
                        {
                            <button class="btn btn-outline-primary btn-sm mt-2" @onclick="() => changingPhone = true">Сменить телефон</button>
                        }
                        else
                        {
                            <div class="mt-2"><ContactBind Phone="true" NeedPassword="profile.Phone != null" OnDone="EmailDone" /></div>
                        }
                    </div>
                }

                <h5 class="mt-4">Сменить пароль</h5>
                @if (profile.TempPassword != null)
                {
                    @* учебная часть выдала временный пароль: показываем его, пока студент не сменит *@
                    <div class="alert alert-warning py-2" style="max-width:420px">
                        Вам выдан временный пароль. Вставьте его в «Старый пароль» и придумайте свой.
                        <div class="d-flex align-items-center gap-2 mt-2">
                            <code class="eq-temp-pass">@profile.TempPassword</code>
                            @* значок «копировать»; после нажатия на 2 секунды становится галочкой *@
                            <button type="button" class="eq-copy" title="Скопировать" @onclick="() => Copy(profile.TempPassword)">
                                @if (copied)
                                {
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M5 12l5 5L20 7" />
                                    </svg>
                                }
                                else
                                {
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="9" y="9" width="12" height="12" rx="2" />
                                        <path d="M5 15V5a2 2 0 0 1 2-2h10" />
                                    </svg>
                                }
                            </button>
                        </div>
                    </div>
                }
                <div class="eq-enter" style="max-width:420px">
                    <PasswordInput Class="mb-2" Placeholder="Старый пароль" @bind-Value="oldPassword" />
                    <PasswordInput Class="mb-2" Placeholder="Новый пароль" @bind-Value="newPassword" />
                    <PasswordInput Class="mb-2" Placeholder="Повторите новый пароль" @bind-Value="repeat" />
                    <button class="btn btn-primary eq-submit" @onclick="ChangePassword">Сменить пароль</button>
                </div>
            }
        </div>
    </div>
}

@code {
    // ?tab=data — открыть сразу нужный раздел (ссылка с главной)
    [SupplyParameterFromQuery] public string? Tab { get; set; }

    private record ProfileDto(string Login, string FullName, string Group, string Role, int? OfficeId, string? Office,
        string Status, string? RejectReason,
        string? PendingFullName, string? PendingGroup,
        int? PendingOfficeId, string? PendingOffice, string? PendingReason,
        int Access, string AccessName, string? Punishment, DateTime? NextDrop,
        string? DataBlock, List<string> Warnings, string? Email,
        string? EmailFull, string? TempPassword,
        string? Phone, string? PhoneFull, bool DataLocked);
    private record PasswordResult(string Text, string Token);   // ответ на смену пароля: текст и новый пропуск
    private record MyBookingDto(int Id, string Text, bool CanCancel);

    // первая буква заглавная: «без ограничений» → «Без ограничений»
    private static string Capital(string s) => s.Length == 0 ? s : char.ToUpper(s[0]) + s[1..];

    // статус по-русски
    private static string StatusText(string s) => s switch
    {
        "Approved" => "подтверждена",
        "Rejected" => "отклонена",
        _ => "на проверке"
    };

    private ProfileDto? profile;
    private List<MyBookingDto>? myBookings;

    private string tab = "data";       // открытый раздел: "bookings", "data" или "settings"
    private bool editing;              // нажали «Изменить»
    private bool changingEmail;        // нажали «Сменить почту»
    private bool showEmail;            // глазик у почты: показать адрес полностью
    private bool changingPhone;        // нажали «Сменить телефон»
    private bool showPhone;            // глазик у телефона
    private bool copied;               // временный пароль только что скопировали — показываем галочку
    private StudentForm form = new();  // поля для «Изменить»

    private string oldPassword = "";
    private string newPassword = "";
    private string repeat = "";

    private string? message;
    private bool ok;     // зелёная или красная плашка

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
            return;
        await Load();
        // студенту сначала показываем его записи, админу — данные
        tab = Tab ?? (profile!.Role == "Student" ? "bookings" : "data");
    }

    private async Task Load()
    {
        profile = await Http.GetFromJsonAsync<ProfileDto>("api/profile");

        // админ подтвердил новое ФИО — обновить имя справа сверху без перевхода
        if (Auth.FullName != profile!.FullName)
            await Auth.SetFullName(profile.FullName);

        if (profile.Role == "Student")
            myBookings = await Http.GetFromJsonAsync<List<MyBookingDto>>("api/slots/my");
    }

    private void Open(string to)
    {
        tab = to;
        message = null;
        editing = false;
        changingEmail = false;
        changingPhone = false;
    }

    // почту (или телефон) привязали или сменили — показать ответ сервера и обновить данные
    private async Task EmailDone(string text)
    {
        ok = true;
        message = text;
        changingEmail = false;
        changingPhone = false;
        await Load();
    }

    // «Изменить»: в полях — заявка на проверке, если она есть, иначе текущие данные
    private void StartEdit()
    {
        form.Fill(profile!.PendingFullName ?? profile.FullName, profile.PendingGroup ?? profile.Group,
                  profile.PendingOfficeId ?? profile.OfficeId ?? 0);
        message = null;
        editing = true;
    }

    // показать ответ сервера зелёным или красным
    private async Task Show(HttpResponseMessage resp)
    {
        ok = resp.IsSuccessStatusCode;
        message = await resp.Content.ReadAsStringAsync();
    }

    private async Task SaveData()
    {
        var error = form.Check(needOffice: true);
        if (error != null)
        {
            ok = false;
            message = error;
            return;
        }

        await Show(await Http.PutAsJsonAsync("api/profile", form.ToJson()));
        if (ok)
            editing = false;
        // обновить данные и при отказе тоже: плашка «На проверке» должна показывать то, что реально лежит в базе
        // (админ мог уже подтвердить заявку, пока страница была открыта)
        await Load();
    }

    private async Task CancelBooking(int id)
    {
        var resp = await Http.DeleteAsync($"api/slots/my/{id}");

        // 409: до записи меньше 30 минут — сервер спрашивает, отменять ли (засчитается неявка)
        if (resp.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            if (!await JS.InvokeAsync<bool>("confirm", await resp.Content.ReadAsStringAsync()))
                return;
            resp = await Http.DeleteAsync($"api/slots/my/{id}?confirm=true");
        }

        await Show(resp);
        await Load();
    }

    private async Task ChangePassword()
    {
        if (newPassword != repeat)
        {
            ok = false;
            message = "Новые пароли не совпадают";
            return;
        }

        var resp = await Http.PostAsJsonAsync("api/auth/password", new { oldPassword, newPassword });
        ok = resp.IsSuccessStatusCode;
        if (!ok)
        {
            message = await resp.Content.ReadAsStringAsync();   // «Старый пароль введён неверно»
            return;
        }

        // сервер выдал новый пропуск: старые (на других устройствах) больше не действуют, а этот — да
        var data = (await resp.Content.ReadFromJsonAsync<PasswordResult>())!;
        await Auth.SetToken(data.Token);
        message = data.Text;
        oldPassword = newPassword = repeat = "";
    }

    // скопировать текст в буфер обмена; значок на 2 секунды меняется на галочку
    private async Task Copy(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        copied = true;
        StateHasChanged();        // перерисовать сразу, не дожидаясь конца паузы
        await Task.Delay(2000);
        copied = false;
    }

    // «Выйти» — выходим и сразу открываем окно входа
    private async Task Logout()
    {
        await Auth.Logout();
        Nav.NavigateTo("login");
    }
}