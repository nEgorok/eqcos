@page "/admin"
@inject HttpClient Http
@inject AuthService Auth

<PageTitle>Все записи</PageTitle>
<h1>Все записи</h1>

@if (Auth.Role != "Admin")
{
    <p>Нет доступа. Войдите как администратор.</p>
}
else if (bookings == null)
{
    <p>Загрузка...</p>
}
else if (bookings.Count == 0)
{
    <p>Записей нет</p>
}
else
{
    @if (message != null)
    {
        <div class="alert alert-secondary">@message</div>
    }

    <table class="table">
        <thead>
            <tr>
                <th>Время</th>
                <th>ФИО</th>
                <th>Группа</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in bookings)
            {
                <tr>
                    <td>@b.Time.ToString("HH:mm")</td>
                    <td>@b.StudentName</td>
                    <td>@b.Group</td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(b.Id)">Удалить</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    // такая же запись, как Booking на сервере
    private record BookingDto(int Id, TimeOnly Time, string StudentName, string Group, int StudentId);

    private List<BookingDto>? bookings;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.Role == "Admin")
            await Load();
    }

    private async Task Load()
    {
        bookings = await Http.GetFromJsonAsync<List<BookingDto>>("api/slots/bookings");
    }

    private async Task Delete(int id)
    {
        var resp = await Http.DeleteAsync($"api/slots/bookings/{id}");
        message = await resp.Content.ReadAsStringAsync();
        await Load();
    }
}