@page "/admin"
@inject HttpClient Http
@inject AuthService Auth

<PageTitle>Записи</PageTitle>
<h1>Записи моего корпуса</h1>

@if (Auth.Role != "Admin")
{
    <p>Нет доступа. Войдите как администратор.</p>
}
else
{
    <div class="mb-3" style="max-width:220px">
        <input type="date" class="form-control"
               value="@date.ToString("yyyy-MM-dd")"
               @onchange="DateChanged" />
    </div>

    @* ---- Назначить вызов ---- *@
    <div class="card mb-3" style="max-width:520px">
        <div class="card-body">
            <h5 class="card-title">Вызов на профбеседу (30 минут)</h5>
            <div class="d-flex gap-2">
                <input class="form-control" placeholder="Номер студенческого" @bind="summonLogin" />
                <input type="time" step="300" class="form-control" style="max-width:130px" @bind="summonTime" />
                <button class="btn btn-warning" @onclick="Summon">Вызвать</button>
            </div>
            <small class="text-muted">На выбранный выше день</small>
        </div>
    </div>

    @if (message != null)
    {
        <div class="alert alert-secondary">@message</div>
    }

    @if (bookings == null)
    {
        <p>Загрузка...</p>
    }
    else if (bookings.Count == 0)
    {
        <p>На этот день записей нет</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Время</th>
                    <th>ФИО</th>
                    <th>Группа</th>
                    <th>Цель</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in bookings)
                {
                    <tr>
                        <td>@b.Time.ToString("HH:mm")</td>
                        <td>@b.StudentName</td>
                        <td>@b.Group</td>
                        <td>@b.Purpose</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(b.Id)">Удалить</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private record BookingDto(int Id, TimeOnly Time, string StudentName, string Group, string Purpose);

    private DateOnly date = DateOnly.FromDateTime(DateTime.Now);
    private List<BookingDto>? bookings;
    private string? message;

    private string summonLogin = "";      // номер студенческого
    private TimeOnly summonTime = new TimeOnly(14, 0);  // время вызова

    protected override async Task OnInitializedAsync()
    {
        if (Auth.Role == "Admin")
            await Load();
    }

    private async Task Load()
    {
        bookings = await Http.GetFromJsonAsync<List<BookingDto>>(
            $"api/slots/bookings?date={date:yyyy-MM-dd}");
    }

    private async Task DateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
        {
            date = d;
            message = null;
            await Load();
        }
    }

    // назначить вызов
    private async Task Summon()
    {
        if (summonLogin == "")
        {
            message = "Введите номер студенческого";
            return;
        }

        var resp = await Http.PostAsJsonAsync("api/slots/summon", new
        {
            studentLogin = summonLogin,
            date = date.ToString("yyyy-MM-dd"),
            time = summonTime.ToString("HH:mm:ss")
        });
        message = await resp.Content.ReadAsStringAsync();
        await Load();
    }

    private async Task Delete(int id)
    {
        var resp = await Http.DeleteAsync($"api/slots/bookings/{id}");
        message = await resp.Content.ReadAsStringAsync();
        await Load();
    }
}