@page "/admin"
@inject HttpClient Http
@inject AuthService Auth
@implements IDisposable

<PageTitle>Записи</PageTitle>
<h1>Записи моего корпуса</h1>

@if (Auth.Role != "Admin")
{
    <p>Нет доступа. Войдите как администратор.</p>
}
else
{
    <div class="mb-3" style="max-width:220px">
        <input type="date" class="form-control"
               value="@date.ToString("yyyy-MM-dd")"
               @onchange="DateChanged" />
    </div>

    <div class="d-flex flex-wrap gap-3 mb-3">
        @* ---- Назначить вызов ---- *@
        <div class="card" style="max-width:520px">
            <div class="card-body">
                <h5 class="card-title">Вызов на профбеседу (30 минут)</h5>
                <div class="d-flex gap-2">
                    <input class="form-control" placeholder="Номер студенческого" @bind="summonLogin" />
                    <input type="time" step="300" class="form-control" style="max-width:130px" @bind="summonTime" />
                    <button class="btn btn-warning" @onclick="Summon">Вызвать</button>
                </div>
                <small class="text-muted">На выбранный выше день</small>
            </div>
        </div>

        @* ---- Закрыть время ---- *@
        <div class="card" style="max-width:620px">
            <div class="card-body">
                <h5 class="card-title">Закрыть время</h5>
                <div class="d-flex gap-2">
                    <input type="time" step="300" class="form-control" style="max-width:130px" @bind="closeStart" />
                    <input type="time" step="300" class="form-control" style="max-width:130px" @bind="closeEnd" />
                    <input class="form-control" placeholder="Причина (Совещание)" @bind="closeReason" />
                    <button class="btn btn-secondary" @onclick="CloseTime">Закрыть</button>
                </div>
                <small class="text-muted">С — по, на выбранный выше день. Весь день: 08:00 — 16:30</small>
            </div>
        </div>
    </div>

    @if (message != null)
    {
        <div class="alert alert-secondary">@message</div>
    }

    @* ---- Закрытое время на день (видно всегда) ---- *@
    <h5>Закрытое время</h5>
    @if (closures == null || closures.Count == 0)
    {
        <p class="text-muted">Закрытого времени нет</p>
    }
    else
    {
        <ul class="list-group mb-3" style="max-width:620px">
            @foreach (var c in closures)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@c.Start.ToString("HH:mm")–@c.End.ToString("HH:mm"): @c.Reason</span>
                    <button class="btn btn-sm btn-outline-success" @onclick="() => OpenTime(c.Id)">Открыть</button>
                </li>
            }
        </ul>
    }

    <h5 class="mt-4">Записи на день</h5>
    @if (bookings == null)
    {
        <p>Загрузка...</p>
    }
    else if (bookings.Count == 0)
    {
        <p>На этот день записей нет</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Время</th>
                    <th>ФИО</th>
                    <th>Группа</th>
                    <th>Цель</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in bookings)
                {
                    <tr>
                        <td>@b.Time.ToString("HH:mm")</td>
                        <td>@b.StudentName</td>
                        <td>@b.Group</td>
                        <td>@b.Purpose</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(b.Id)">Удалить</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private record BookingDto(int Id, TimeOnly Time, string StudentName, string Group, string Purpose);
    private record ClosureDto(int Id, TimeOnly Start, TimeOnly End, string Reason);

    private DateOnly date = DateOnly.FromDateTime(DateTime.Now);
    private List<BookingDto>? bookings;
    private List<ClosureDto>? closures;
    private string? message;

    private string summonLogin = "";
    private TimeOnly summonTime = new TimeOnly(14, 0);

    private TimeOnly closeStart = new TimeOnly(10, 0);
    private TimeOnly closeEnd = new TimeOnly(11, 0);
    private string closeReason = "Совещание";

    private System.Threading.Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.Role == "Admin")
        {
            await Load();
            // раз в 5 секунд тихо обновлять
            timer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(async () =>
       {
           try
           {
               await Load();
               StateHasChanged();
           }
           catch (HttpRequestException)
           {
               // нет связи или вход истёк — шапка уже показала, что случилось; попробуем через 5 секунд
           }
       });
            }, null, 5000, 5000);
        }
    }

    // ушли со страницы — остановить таймер
    public void Dispose() => timer?.Dispose();

    private async Task Load()
    {
        bookings = await Http.GetFromJsonAsync<List<BookingDto>>(
            $"api/slots/bookings?date={date:yyyy-MM-dd}");
        closures = await Http.GetFromJsonAsync<List<ClosureDto>>(
            $"api/closures/mine?date={date:yyyy-MM-dd}");
    }

    private async Task DateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
        {
            date = d;
            message = null;
            await Load();
        }
    }

    private async Task Summon()
    {
        if (summonLogin == "")
        {
            Say("Введите номер студенческого");
            return;
        }

        var resp = await Http.PostAsJsonAsync("api/slots/summon", new
        {
            studentLogin = summonLogin,
            date = date.ToString("yyyy-MM-dd"),
            time = summonTime.ToString("HH:mm:ss")
        });
        Say(await resp.Content.ReadAsStringAsync());
        await Load();
    }

    private async Task CloseTime()
    {
        var resp = await Http.PostAsJsonAsync("api/closures", new
        {
            date = date.ToString("yyyy-MM-dd"),
            start = closeStart.ToString("HH:mm:ss"),
            end = closeEnd.ToString("HH:mm:ss"),
            reason = closeReason
        });
        Say(await resp.Content.ReadAsStringAsync());
        await Load();
    }

    private async Task OpenTime(int id)
    {
        var resp = await Http.DeleteAsync($"api/closures/{id}");
        Say(await resp.Content.ReadAsStringAsync());
        await Load();
    }

    private async Task Delete(int id)
    {
        var resp = await Http.DeleteAsync($"api/slots/bookings/{id}");
        Say(await resp.Content.ReadAsStringAsync());
        await Load();
    }

    // показать сообщение и убрать его через 5 секунд
    private void Say(string text)
    {
        message = text;
        _ = HideLater(text);   // "_ =" — запустить и не ждать
    }

    private async Task HideLater(string text)
    {
        await Task.Delay(5000);
        if (message == text)   // если за это время не пришло новое сообщение
        {
            message = null;
            StateHasChanged();
        }
    }
}