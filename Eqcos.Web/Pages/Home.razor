@page "/"
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Запись в учебную часть</PageTitle>

@if (Auth.IsLoggedIn && Auth.Role == "Student")
{
    <div class="alert alert-info">
        @myBooking
        @if (hasBooking)
        {
            <button class="btn btn-sm btn-outline-danger ms-3" @onclick="Cancel">Отменить запись</button>
        }
    </div>
}

@if (message != null)
{
    <div class="alert alert-secondary">@message</div>
}

@* ---- Вкладки корпусов ---- *@
@if (offices != null)
{
    <ul class="nav nav-tabs mb-3">
        @foreach (var o in offices)
        {
            <li class="nav-item">
                <button class="nav-link @(o.Id == officeId ? "active" : "")"
                        @onclick="() => SelectOffice(o.Id)">
                    @o.Name
                </button>
            </li>
        }
    </ul>
}

@* ---- Выбор дня ---- *@
<div class="mb-3" style="max-width:220px">
    <input type="date" class="form-control"
           value="@date.ToString("yyyy-MM-dd")"
           min="@today.ToString("yyyy-MM-dd")"
           @onchange="DateChanged" />
</div>

@* ---- Цель визита ---- *@
@if (purposes != null)
{
    <div class="mb-3" style="max-width:420px">
        <select class="form-select" @bind="purposeId">
            <option value="0">— выберите цель визита —</option>
            @foreach (var p in purposes)
            {
                <option value="@p.Id">@p.Name</option>
            }
        </select>
    </div>
}

<h2>Свободное время</h2>

@if (slots == null)
{
    <p>Загрузка...</p>
}
else if (slots.Count == 0)
{
    <p>Свободного времени нет</p>
}
else
{
    @* группируем по часу: "08:05" -> "08" *@
    @foreach (var hour in slots.GroupBy(s => s.Substring(0, 2)))
    {
        <div class="mb-2">
            <strong class="me-2">@(hour.Key):00</strong>
            @foreach (var s in hour)
            {
                <button class="btn btn-sm btn-outline-primary m-1" @onclick="() => Book(s)">@s</button>
            }
        </div>
    }
}

@code {
    // такой же корпус, как Office на сервере (берём только нужное)
    private record OfficeDto(int Id, string Name);
    private record PurposeDto(int Id, string Name, int Minutes);

    private List<PurposeDto>? purposes;
    private int purposeId = 0;   // 0 = цель ещё не выбрана
    private List<OfficeDto>? offices;
    private int officeId = 1;                                        // выбранный корпус
    private static DateOnly today = DateOnly.FromDateTime(DateTime.Now);
    private DateOnly date = today;                                   // выбранный день

    private List<string>? slots;     // свободное время
    private string? myBooking;       // "Вы записаны: ..." / "У вас нет записи"
    private bool hasBooking;         // показывать ли кнопку отмены
    private string? message;         // ответ сервера после действия

    protected override async Task OnInitializedAsync()
    {
        offices = await Http.GetFromJsonAsync<List<OfficeDto>>("api/offices");
        purposes = await Http.GetFromJsonAsync<List<PurposeDto>>("api/purposes");
        await LoadAll();
    }

    // загрузить свободное время выбранного корпуса и дня + свою запись
    private async Task LoadAll()
    {
        slots = null;   // пока грузится — "Загрузка..."
        slots = await Http.GetFromJsonAsync<List<string>>(
            $"api/slots/free?officeId={officeId}&date={date:yyyy-MM-dd}");

        if (Auth.IsLoggedIn && Auth.Role == "Student")
        {
            myBooking = await Http.GetStringAsync("api/slots/my");
            hasBooking = myBooking.StartsWith("Вы записаны");
        }
    }

    // клик по вкладке корпуса
    private async Task SelectOffice(int id)
    {
        officeId = id;
        message = null;
        await LoadAll();
    }

    // выбрали другой день в календаре
    private async Task DateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
        {
            date = d;
            message = null;
            await LoadAll();
        }
    }

       // клик по времени
    private async Task Book(string time)
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("login");   // гостя — на вход
            return;
        }

        if (purposeId == 0)
        {
            message = "Сначала выберите цель визита";
            return;
        }

        var resp = await Http.PostAsJsonAsync("api/slots/book", new
        {
            officeId,
            date = date.ToString("yyyy-MM-dd"),
            time = time + ":00",
            purposeId
        });
        message = await resp.Content.ReadAsStringAsync();
        await LoadAll();
    }

    // отмена своей записи
    private async Task Cancel()
    {
        var resp = await Http.DeleteAsync("api/slots/my");
        message = await resp.Content.ReadAsStringAsync();
        await LoadAll();
    }
}