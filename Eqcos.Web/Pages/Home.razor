@page "/"
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Запись в учебную часть</PageTitle>
<h1>Запись в учебную часть</h1>

@* ---- Уведомления ---- *@
@if (notifications != null)
{
    @foreach (var n in notifications)
    {
        <div class="alert alert-primary">
            @n.Text
            <div class="mt-2">
                <button class="btn btn-sm btn-primary" @onclick="() => NotifyOk(n.Id)">Понятно</button>
                @if (n.CanChange)
                {
                    <button class="btn btn-sm btn-outline-primary ms-2" @onclick="() => NotifyOther(n.Id)">Выбрать другое время</button>
                }
            </div>
        </div>
    }
}

@* ---- Статус учётной записи (свои записи и вызовы — в профиле) ---- *@
@if (me != null && me.Status == "Pending")
{
    <div class="alert alert-warning">
        Ваша учётная запись на проверке в учебной части. Записаться можно будет после подтверждения.
    </div>
}
@if (me != null && me.Status == "Rejected")
{
    <div class="alert alert-danger">
        Учётная запись не подтверждена: @me.RejectReason.
        Исправьте данные в <a href="profile?tab=data">профиле</a>, и они снова уйдут на проверку.
    </div>
}
@if (Auth.IsLoggedIn && Auth.Role == "Student" && !Auth.HasEmail)
{
    @* почта не привязана: напоминаем, пока не привяжет *@
    <div class="alert alert-info">
        Почта не привязана: без неё не получится сбросить пароль, если вы его забудете.
        <a href="profile?tab=settings">Привязать почту</a>
    </div>
}
@if (me != null && me.Status == "Approved" && (me.PendingFullName != null || me.PendingGroup != null))
{
    <div class="alert alert-warning">
        Изменение ваших данных на проверке в учебной части. Записываться можно, пока действуют прежние данные.
    </div>
}
@if (me?.Warnings != null)
{
    @* предупреждения: скрыть нельзя, пропадут сами, когда сгорят *@
    @foreach (var w in me.Warnings)
    {
        <div class="alert alert-warning eq-warn">
            <b>⚠ Предупреждение.</b> @w
        </div>
    }
}
@if (me?.BookBlock != null)
{
    @* бан, ограничение или спам: записаться нельзя, свободное время смотреть можно *@
    <div class="alert alert-danger">
        <b>Записаться сейчас нельзя.</b> @me.BookBlock
    </div>
}
@if (message != null)
{
    <div class="eq-toast">@message</div>
}

@* ---- Вкладки корпусов ---- *@
@if (offices != null)
{
    <ul class="nav nav-tabs mb-3">
        @foreach (var o in offices)
        {
            <li class="nav-item">
                <button class="nav-link @(o.Id == officeId ? "active" : "")"
                        @onclick="() => SelectOffice(o.Id)">
                    @o.Name
                </button>
            </li>
        }
    </ul>
}

@* ---- Выбор дня ---- *@
<div class="mb-3" style="max-width:220px">
    <input type="date" class="form-control"
           value="@date.ToString("yyyy-MM-dd")"
           min="@today.ToString("yyyy-MM-dd")"
           max="@maxDate.ToString("yyyy-MM-dd")"
           @onchange="DateChanged" />
    <small class="text-muted">Запись — не дальше чем до @maxDate.ToString("dd.MM")</small>
</div>

@* ---- Цель визита ---- *@
@if (purposes != null)
{
    <div class="mb-3" style="max-width:420px">
        <EqSelect Items="@purposes.Select(p => new SelectItem(p.Id, p.Name)).ToList()"
                  @bind-Value="purposeId"
                  Placeholder="— выберите цель визита —" />
    </div>
}

<h2>Свободное время</h2>

@if (slots == null)
{
    <p>Загрузка...</p>
}
else if (IsWeekend(date))
{
    <p>Суббота и воскресенье — выходные, учебная часть не работает</p>
}
else if (date > maxDate)
{
    <p>Записаться можно не дальше чем до @maxDate.ToString("dd.MM")</p>
}
else if (slots.Count == 0)
{
    <p>Свободного времени нет</p>
}
else
{
    @foreach (var hour in slots.GroupBy(s => s.Substring(0, 2)))
    {
        <div class="mb-2">
            <strong class="me-2">@(hour.Key):00</strong>
            @foreach (var s in hour)
            {
                <button class="btn btn-sm btn-outline-primary m-1" disabled="@(me?.BookBlock != null)" @onclick="() => Book(s)">@s</button>
            }
        </div>
    }
}

@code {
    private record OfficeDto(int Id, string Name);
    private record PurposeDto(int Id, string Name, int Minutes);
    private record NotificationDto(int Id, string Text, bool CanChange);
    private record StatusDto(string Status, int? OfficeId, string? RejectReason, string? PendingFullName, string? PendingGroup,
                             string? BookBlock,       // почему нельзя записаться (бан и т.п.); null — можно
                             List<string>? Warnings); // действующие предупреждения (жёлтые плашки)
    private StatusDto? me;   // статус моей учётной записи

    private List<OfficeDto>? offices;
    private List<PurposeDto>? purposes;
    private int officeId = 1;
    private int purposeId = 0;
    private record CalendarDto(DateOnly Today, DateOnly MaxDate);
    private DateOnly today;     // сегодня по Москве (берём с сервера, а не с часов компьютера)
    private DateOnly maxDate;   // последний день, на который можно записаться
    private DateOnly date;      // выбранный день

    private List<string>? slots;
    private List<NotificationDto>? notifications;
    private string? message;

    private System.Threading.Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        var calendar = (await Http.GetFromJsonAsync<CalendarDto>("api/calendar"))!;
        today = calendar.Today;
        maxDate = calendar.MaxDate;
        date = today;
        while (IsWeekend(date))
            date = date.AddDays(1);   // сегодня выходной — сразу показываем понедельник

        offices = await Http.GetFromJsonAsync<List<OfficeDto>>("api/offices");

        // студент записывается только в свой корпус — показываем только его вкладку (гость видит все)
        if (Auth.IsLoggedIn && Auth.Role == "Student")
        {
            me = await Http.GetFromJsonAsync<StatusDto>("api/profile");
            if (me!.OfficeId != null)
            {
                offices = offices!.Where(o => o.Id == me.OfficeId).ToList();
                officeId = me.OfficeId.Value;
            }
        }
        purposes = await Http.GetFromJsonAsync<List<PurposeDto>>("api/purposes");
        await LoadAll();

        // раз в 5 секунд тихо обновлять
        timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
   {
       try
       {
           await LoadAll(quiet: true);
           StateHasChanged();
       }
       catch (HttpRequestException)
       {
           // нет связи или вход истёк — шапка уже показала, что случилось; попробуем через 5 секунд
       }
   });
        }, null, 5000, 5000);
    }

    // ушли со страницы — остановить таймер
    public void Dispose() => timer?.Dispose();

    private static bool IsWeekend(DateOnly d) =>
        d.DayOfWeek == DayOfWeek.Saturday || d.DayOfWeek == DayOfWeek.Sunday;

    private async Task LoadAll(bool quiet = false)
    {
        if (!quiet) slots = null;   // при тихом обновлении не мигаем "Загрузка..."
        slots = await Http.GetFromJsonAsync<List<string>>(
            $"api/slots/free?officeId={officeId}&date={date:yyyy-MM-dd}");

        if (Auth.IsLoggedIn && Auth.Role == "Student")
        {
            notifications = await Http.GetFromJsonAsync<List<NotificationDto>>("api/notifications");
            me = await Http.GetFromJsonAsync<StatusDto>("api/profile");
        }
    }

    private async Task SelectOffice(int id)
    {
        officeId = id;
        message = null;
        await LoadAll();
    }

    private async Task DateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d))
        {
            date = d;
            message = null;
            await LoadAll();
        }
    }

    private async Task Book(string time)
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("login");
            return;
        }

        if (purposeId == 0)
        {
            Say("Сначала выберите цель визита");
            return;
        }

        var resp = await Http.PostAsJsonAsync("api/slots/book", new
        {
            officeId,
            date = date.ToString("yyyy-MM-dd"),
            time = time + ":00",
            purposeId
        });
        Say(await resp.Content.ReadAsStringAsync());   // «Вы записаны: ...» — сама запись теперь в профиле
        await LoadAll();
    }

    // "Ок" — скрыть уведомление
    private async Task NotifyOk(int id)
    {
        await Http.PostAsync($"api/notifications/{id}/ok", null);
        await LoadAll();
    }

    // "Выбрать другое время" — отменить перенесённую запись
    private async Task NotifyOther(int id)
    {
        var resp = await Http.PostAsync($"api/notifications/{id}/other", null);
        message = await resp.Content.ReadAsStringAsync();
        await LoadAll();
    }
    // показать сообщение и убрать его через 5 секунд
    private void Say(string text)
    {
        message = text;
        _ = HideLater(text);   // "_ =" — запустить и не ждать
    }

    private async Task HideLater(string text)
    {
        await Task.Delay(5000);
        if (message == text)   // если за это время не пришло новое сообщение
        {
            message = null;
            StateHasChanged();
        }
    }
}