@page "/"
@inject HttpClient Http

<PageTitle>Запись в учебную часть</PageTitle>

<h1>Свободное время</h1>

@if (slots == null)
{
    <p>Загрузка...</p>
}
else if (slots.Count == 0)
{
    <p>Свободного времени нет</p>
}
else
{
    <div>
        @foreach (var s in slots)
        {
            <button class="btn btn-outline-primary m-1">@s</button>
        }
    </div>
}

@code {
    private List<string>? slots;   // null = ещё грузится

    // выполняется один раз при открытии страницы
    protected override async Task OnInitializedAsync()
    {
        slots = await Http.GetFromJsonAsync<List<string>>("api/slots/free");
    }
}