@page "/password"
@inject HttpClient Http
@inject AuthService Auth

<PageTitle>Смена пароля</PageTitle>
<h1>Смена пароля</h1>

@if (!Auth.IsLoggedIn)
{
    <p>Сначала войдите.</p>
}
else
{
    <div style="max-width:320px">
        <input class="form-control mb-2" type="password" placeholder="Старый пароль" @bind="oldPassword" />
        <input class="form-control mb-2" type="password" placeholder="Новый пароль" @bind="newPassword" />
        <input class="form-control mb-2" type="password" placeholder="Повторите новый пароль" @bind="repeat" />
        <button class="btn btn-primary" @onclick="Save">Сохранить</button>

        @if (message != null)
        {
            <div class="mt-2 @(ok ? "text-success" : "text-danger")">@message</div>
        }
    </div>
}

@code {
    private string oldPassword = "";
    private string newPassword = "";
    private string repeat = "";
    private string? message;
    private bool ok;   // зелёный или красный текст

    private async Task Save()
    {
        if (newPassword != repeat)
        {
            ok = false;
            message = "Новые пароли не совпадают";
            return;
        }

        var resp = await Http.PostAsJsonAsync("api/auth/password", new { oldPassword, newPassword });
        ok = resp.IsSuccessStatusCode;
        message = await resp.Content.ReadAsStringAsync();

        if (ok)
            oldPassword = newPassword = repeat = "";   // очистить поля
    }
}