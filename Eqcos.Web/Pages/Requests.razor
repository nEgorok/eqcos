@page "/requests"
@inject HttpClient Http
@inject AuthService Auth

<PageTitle>Заявки</PageTitle>
<h1>Заявки на подтверждение</h1>

@if (Auth.Role != "Admin")
{
    <p>Нет доступа. Войдите как администратор.</p>
}
else if (list == null)
{
    <p>Загрузка...</p>
}
else
{
    <button class="btn btn-outline-secondary btn-sm mb-3" @onclick="Load">Обновить</button>

    @if (message != null)
    {
        <div class="eq-toast">@message</div>
    }

    @if (list.Count == 0)
    {
        <p>Новых заявок нет</p>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr><th>Студенческий</th><th>Заявка</th><th>ФИО</th><th>Группа</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var s in list)
                {
                    <tr>
                        <td>@s.Login</td>
                        <td>@s.Kind</td>
                        <td>
                            @if (s.NewFullName != null && s.NewFullName != s.FullName)
                            {
                                <span class="text-muted text-decoration-line-through">@s.FullName</span><br />
                                <b>@s.NewFullName</b>
                            }
                            else
                            {
                                @s.FullName
                            }
                        </td>
                        <td>
                            @if (s.NewGroup != null && s.NewGroup != s.Group)
                            {
                                <span class="text-muted text-decoration-line-through">@s.Group</span><br />
                                <b>@s.NewGroup</b>
                            }
                            else
                            {
                                @s.Group
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-success" @onclick="() => Approve(s.Id)">Подтвердить</button>
                                <input class="form-control form-control-sm" style="max-width:220px"
                                       placeholder="Причина отказа" @bind="reasons[s.Id]" />
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Reject(s.Id)">Отклонить</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private record RequestDto(int Id, string Login, string Kind, string FullName, string Group,
                              string? NewFullName, string? NewGroup);

    private List<RequestDto>? list;
    private Dictionary<int, string> reasons = new();   // Id студента -> введённая причина
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.Role == "Admin")
            await Load();
    }

    private async Task Load()
    {
        list = await Http.GetFromJsonAsync<List<RequestDto>>("api/requests");

        // у каждой строки своё поле "Причина"
        foreach (var s in list!)
            if (!reasons.ContainsKey(s.Id))
                reasons[s.Id] = "";
    }

    private async Task Approve(int id)
    {
        var s = list!.First(x => x.Id == id);
        // отправляем то, что админ видит на экране
        var resp = await Http.PostAsJsonAsync($"api/requests/{id}/approve",
            new { fullName = s.NewFullName ?? s.FullName, group = s.NewGroup ?? s.Group });
        Say(await resp.Content.ReadAsStringAsync());
        await Load();
    }

    private async Task Reject(int id)
    {
        var s = list!.First(x => x.Id == id);
        var resp = await Http.PostAsJsonAsync($"api/requests/{id}/reject",
            new { reason = reasons[id], fullName = s.NewFullName ?? s.FullName, group = s.NewGroup ?? s.Group });
        Say(await resp.Content.ReadAsStringAsync());
        reasons[id] = "";
        await Load();
    }

    // показать сообщение и убрать его через 5 секунд
    private void Say(string text)
    {
        message = text;
        _ = HideLater(text);
    }

    private async Task HideLater(string text)
    {
        await Task.Delay(5000);
        if (message == text)
        {
            message = null;
            StateHasChanged();
        }
    }
}