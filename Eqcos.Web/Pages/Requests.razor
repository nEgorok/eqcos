@page "/requests"
@inject HttpClient Http
@inject AuthService Auth
@inject IJSRuntime JS

<PageTitle>Заявки</PageTitle>
<h1>Заявки на подтверждение</h1>

@* подсказки причины отказа: можно выбрать или написать свою *@
<datalist id="reject-reasons">
    <option value="Неверный номер студенческого"></option>
    <option value="ФИО написано с ошибкой"></option>
    <option value="Неверная группа"></option>
    <option value="Такого студента нет в списках"></option>
</datalist>

@if (Auth.Role != "Secretary")
{
    <p>Нет доступа. Войдите как администратор.</p>
}
else if (list == null)
{
    <p>Загрузка...</p>
}
else
{
    @* ---- Список техникума: режим и поиск (только если список подключён на сервере) ---- *@
    @if (mode.Enabled)
    {
        <div class="card mb-3" style="max-width:760px">
            <div class="card-body">
                <h5 class="card-title">Список техникума</h5>
                <div class="small text-muted mb-2">
                    @if (mode.Sync)
                    {
                        <div>Синхронизация включена: ФИО, группа и корпус студентов берутся из списка (при входе, при открытии профиля и раз в час). Ни студент, ни админ сами их не меняют.</div>
                    }
                    @if (mode.Auto)
                    {
                        <span>
                            Автоматическая проверка включена: новые регистрации подтверждаются и отклоняются сами.
                            Здесь остаются изменения данных, переводы и заявки, поданные раньше.
                        </span>
                    }
                    else
                    {
                        <span>Проверка вручную: сверка каждой заявки — в колонке «Список техникума».</span>
                    }
                </div>
                <input class="form-control" style="max-width:320px" placeholder="Номер или фамилия"
                       @bind="collegeQuery" @bind:event="oninput" @bind:after="CollegeTyped" />
                @if (found.Count > 0)
                {
                    <table class="table table-sm mt-2 mb-0">
                        <tbody>
                            @foreach (var f in found)
                            {
                                <tr><td>@f.Login</td><td>@f.FullName</td><td>@f.Group</td><td>@f.Office</td></tr>
                            }
                        </tbody>
                    </table>
                }
                else if (collegeQuery.Trim() != "" && searched)
                {
                    <div class="small text-muted mt-2">В списке техникума не найдено</div>
                }
            </div>
        </div>
    }

    <button class="btn btn-outline-secondary btn-sm mb-3" @onclick="Load">Обновить</button>

    @if (message != null)
    {
        <div class="eq-toast">@message</div>
    }

    @if (list.Count == 0)
    {
        <p>Новых заявок нет</p>
    }
    else
    {
        @* ---- Отклонить выбранные (галочки слева) ---- *@
        @if (selected.Count > 0)
        {
            <div class="d-flex gap-2 align-items-center mb-3 flex-wrap">
                <span>Выбрано: @selected.Count</span>
                <input class="form-control form-control-sm" style="max-width:260px"
                       list="reject-reasons" placeholder="Причина отказа" @bind="bulkReason" />
                <button class="btn btn-sm btn-outline-danger" @onclick="RejectSelected">Отклонить выбранные</button>
            </div>
        }

        <table class="table align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Студенческий</th>
                    <th>Заявка</th>
                    <th>ФИО</th>
                    <th>Группа</th>
                    <th>Корпус</th>
                    @if (mode.Enabled)
                    {
                        <th>Список техникума</th>
                    }
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in list)
                {
                    <tr>
                        <td>
                            <input class="form-check-input" type="checkbox" checked="@selected.Contains(s.Id)"
                                   @onchange="e => Toggle(s.Id, (bool)e.Value!)" />
                        </td>
                        <td>@s.Login</td>
                        <td>
                            @s.Kind
                            @if (s.Reason != null)
                            {
                                <div class="small text-muted">@s.Reason</div>
                            }
                        </td>
                        <td>
                            @if (s.NewFullName != null && s.NewFullName != s.FullName)
                            {
                                <span class="text-muted text-decoration-line-through">@s.FullName</span><br />
                                <b>@s.NewFullName</b>
                            }
                            else
                            {
                                @s.FullName
                            }
                        </td>
                        <td>
                            @if (s.NewGroup != null && s.NewGroup != s.Group)
                            {
                                <span class="text-muted text-decoration-line-through">@s.Group</span><br />
                                <b>@s.NewGroup</b>
                            }
                            else
                            {
                                @s.Group
                            }
                        </td>
                        <td style="min-width:200px">
                            @if (s.NewOffice != null && s.NewOffice != s.Office)
                            {
                                <span class="text-muted text-decoration-line-through">@s.Office</span><br />
                            }
                            @* выбрать другой корпус = передать заявку туда (если студент ошибся) *@
                            <EqSelect Items="@officeItems" Value="@(s.TargetOfficeId ?? 0)"
                                      ValueChanged="@(id => Move(s.Id, id))" />
                        </td>
                        @if (mode.Enabled)
                        {
                            <td class="small" style="max-width:220px">
                                @if (s.College?.Ok == true)
                                {
                                    <span class="text-success">✓ совпадает</span>
                                }
                                else if (s.College != null)
                                {
                                    <span class="text-danger">✗ @s.College.Details</span>
                                }
                            </td>
                        }
                        <td>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-success" @onclick="() => Approve(s.Id)">Подтвердить</button>
                                <input class="form-control form-control-sm" style="max-width:220px"
                                       list="reject-reasons" placeholder="Причина отказа" @bind="reasons[s.Id]" />
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Reject(s.Id)">Отклонить</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private record RequestDto(int Id, string Login, string Kind, string? Reason,
                              string FullName, string Group, string? Office,
                              string? NewFullName, string? NewGroup, string? NewOffice, int? TargetOfficeId,
                              CollegeDto? College);
    private record OfficeDto(int Id, string Name);
    private record CollegeDto(bool Ok, string Short, string Details);   // сверка со списком техникума
    private record CollegeMode(bool Enabled, bool Auto, bool Sync);
    private record CollegeStudentDto(string Login, string FullName, string Group, string? Office);

    private List<RequestDto>? list;
    private List<SelectItem> officeItems = new();
    private Dictionary<int, string> reasons = new();   // Id студента -> введённая причина
    private HashSet<int> selected = new();              // отмеченные галочкой
    private string bulkReason = "";
    private string? message;

    private CollegeMode mode = new(false, false, false);
    private string collegeQuery = "";
    private List<CollegeStudentDto> found = new();
    private bool searched;                          // поиск уже отработал (чтобы не мигало «не найдено»)
    private CancellationTokenSource? searchDelay;   // чтобы не искать на каждую букву

    protected override async Task OnInitializedAsync()
    {
        if (Auth.Role != "Secretary")
            return;
        var offices = (await Http.GetFromJsonAsync<List<OfficeDto>>("api/offices"))!;
        officeItems = offices.Select(o => new SelectItem(o.Id, o.Name)).ToList();
        mode = (await Http.GetFromJsonAsync<CollegeMode>("api/requests/college"))!;
        await Load();
    }

    private async Task Load()
    {
        list = await Http.GetFromJsonAsync<List<RequestDto>>("api/requests");

        // у каждой строки своё поле "Причина"
        // если список техникума нашёл расхождение — сразу подставляем причину (админ может исправить)
        foreach (var s in list!)
            if (!reasons.ContainsKey(s.Id))
                reasons[s.Id] = s.College != null && !s.College.Ok
                    ? char.ToUpper(s.College.Short[0]) + s.College.Short.Substring(1)
                    : "";

        // галочки только у тех, кто ещё в списке
        selected.IntersectWith(list.Select(s => s.Id));
    }

    // поиск в списке техникума: ждём 300 мс после последней буквы
    private async Task CollegeTyped()
    {
        searched = false;
        searchDelay?.Cancel();
        searchDelay = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, searchDelay.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        found = await Http.GetFromJsonAsync<List<CollegeStudentDto>>(
            $"api/requests/college/search?q={Uri.EscapeDataString(collegeQuery)}") ?? new();
        searched = true;
    }

    private void Toggle(int id, bool on)
    {
        if (on)
            selected.Add(id);
        else
            selected.Remove(id);
    }

    private async Task Approve(int id)
    {
        var s = list!.First(x => x.Id == id);
        // отправляем то, что админ видит на экране
        var resp = await Http.PostAsJsonAsync($"api/requests/{id}/approve",
            new { fullName = s.NewFullName ?? s.FullName, group = s.NewGroup ?? s.Group });
        Say(await resp.Content.ReadAsStringAsync());
        await Load();
    }

    private async Task Reject(int id)
    {
        var s = list!.First(x => x.Id == id);
        if (s.Kind == "Новая регистрация" &&
            !await JS.InvokeAsync<bool>("confirm", $"Отклонить регистрацию {s.FullName}? Учётная запись будет удалена."))
            return;

        var resp = await SendReject(s, reasons[id]);
        Say(await resp.Content.ReadAsStringAsync());
        reasons[id] = "";
        await Load();
    }

    // отклонить одну заявку; отправляем то, что админ видит на экране
    private Task<HttpResponseMessage> SendReject(RequestDto s, string reason) =>
        Http.PostAsJsonAsync($"api/requests/{s.Id}/reject",
            new { reason, fullName = s.NewFullName ?? s.FullName, group = s.NewGroup ?? s.Group });

    // «Отклонить выбранные»: одна причина на все отмеченные
    private async Task RejectSelected()
    {
        if (bulkReason.Trim() == "")
        {
            Say("Укажите причину отказа");
            return;
        }
        if (!await JS.InvokeAsync<bool>("confirm", $"Отклонить выбранные заявки ({selected.Count})? Новые регистрации будут удалены."))
            return;

        var done = 0;
        foreach (var s in list!.Where(x => selected.Contains(x.Id)).ToList())
        {
            var resp = await SendReject(s, bulkReason);
            if (resp.IsSuccessStatusCode)
                done++;
        }

        Say($"Отклонено заявок: {done} из {selected.Count}");
        selected.Clear();
        bulkReason = "";
        await Load();
    }

    // выбрали другой корпус — передать заявку туда
    private async Task Move(int id, int officeId)
    {
        var s = list!.First(x => x.Id == id);
        if (officeId == s.TargetOfficeId)
            return;
        var name = officeItems.First(o => o.Id == officeId).Name;
        if (!await JS.InvokeAsync<bool>("confirm", $"Передать заявку {s.FullName} в корпус «{name}»? Она пропадёт из вашего списка."))
            return;

        var resp = await Http.PostAsJsonAsync($"api/requests/{id}/office", new { officeId });
        Say(await resp.Content.ReadAsStringAsync());
        await Load();
    }

    // показать сообщение и убрать его через 5 секунд
    private void Say(string text)
    {
        message = text;
        _ = HideLater(text);
    }

    private async Task HideLater(string text)
    {
        await Task.Delay(5000);
        if (message == text)
        {
            message = null;
            StateHasChanged();
        }
    }
}