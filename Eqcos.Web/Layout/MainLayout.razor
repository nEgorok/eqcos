@inject AuthService Auth
@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (Auth.IsLoggedIn)
            {
                <NavLink class="me-3" href="profile" title="Профиль">@Auth.FullName (@Auth.Role)</NavLink>
                <button class="btn btn-link" @onclick="() => Auth.Logout()">Выйти</button>
            }
            else
            {
                <NavLink href="login">Войти</NavLink>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
@code {
    // при входе/выходе перерисовать верхнюю полосу
    protected override void OnInitialized() => Auth.Changed += StateHasChanged;
}
