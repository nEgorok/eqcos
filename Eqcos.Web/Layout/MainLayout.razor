@inject AuthService Auth
@inject ApiState Api
@inject NavigationManager Nav
@inherits LayoutComponentBase

<header class="eq-header">
    @* ---- Верхняя строка: меню ---- *@
    <div class="eq-container eq-topline">
        <nav class="eq-nav">
            @if (Auth.Role != "Admin")
            {
                <NavLink href="" Match="NavLinkMatch.All">Запись</NavLink>
            }
            @if (Auth.Role == "Admin")
            {
                <NavLink href="admin" Match="NavLinkMatch.All">Очередь</NavLink>
                <NavLink href="admin/history">История</NavLink>
                <NavLink href="admin/summon">Вызов</NavLink>
                <NavLink href="admin/close">Закрытие</NavLink>
                <NavLink href="requests">Заявки</NavLink>
                <NavLink href="admin/students">Студенты</NavLink>
            }
        </nav>

        @if (Auth.IsLoggedIn)
        {
            <div class="eq-userbox">
                @* админу — скромное напоминание серой строкой; студенту — плашка на главной *@
                @if (Auth.Role == "Admin" && !Auth.HasEmail)
                {
                    <a class="eq-noemail" href="profile?tab=settings">@(Auth.SmsEnabled ? "почта и телефон не привязаны" : "почта не привязана")</a>
                }
                <NavLink class="eq-user" href="profile" title="Профиль">👤 @Auth.FullName</NavLink>
            </div>
        }
    </div>

    @* ---- Строка с логотипом и кнопками ---- *@
    <div class="eq-container eq-brandline">
        <a class="eq-brand" href="">
            <img src="img/logo.png" alt="" />
            <span>Камский государственный<br />автомеханический техникум<br />им. Л.Б. Васильева</span>
        </a>

        <div class="eq-service">Электронная очередь<br />учебной части</div>

        <div class="eq-actions">
            @* вошли — кнопок нет: профиль открывается по имени сверху, «Выйти» внутри профиля *@
            @if (!Auth.IsLoggedIn)
            {
                <a class="btn eq-btn eq-btn-blue" href="login">Войти</a>
                <a class="btn eq-btn eq-btn-green" href="register">Регистрация</a>
            }
        </div>
    </div>
</header>

@* ---- Нет связи с сервером ---- *@
@if (Api.Offline)
{
    <div class="eq-offline">
        Нет связи с сервером. Проверьте интернет или попробуйте чуть позже.
    </div>
}

<main class="eq-container eq-main">
    @* ErrorBoundary ловит ошибку внутри страницы и показывает ErrorContent вместо жёлтой полоски внизу *@
    <ErrorBoundary @ref="boundary">
        <ChildContent>
            @Body
        </ChildContent>
        <ErrorContent>
            <div class="alert alert-danger">
                @(Api.Offline ? "Не удалось связаться с сервером." : "Что-то пошло не так.")
                <button class="btn btn-sm btn-outline-danger ms-2" @onclick="Reload">Обновить страницу</button>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</main>

<footer class="eq-footer">
    <div class="eq-container">
        ГАПОУ «Камский государственный автомеханический техникум им. Л.Б. Васильева» · Электронная очередь учебной части
    </div>
</footer>

@code {
    private ErrorBoundary? boundary;

    protected override void OnInitialized()
    {
        Auth.Changed += StateHasChanged;                              // вошли/вышли — перерисовать шапку
        Api.Changed += () => InvokeAsync(StateHasChanged);            // связь пропала/появилась — плашка
        Api.Unauthorized += () => InvokeAsync(SessionExpired);        // вход истёк — на окно входа
        Nav.LocationChanged += (_, _) => boundary?.Recover();         // перешли на другую страницу — убрать ошибку
    }

    // сервер ответил 401: пропуск истёк (8 часов) или аккаунт удалён
    private async Task SessionExpired()
    {
        if (!Auth.IsLoggedIn)
            return;   // уже вышли (несколько запросов получили 401 одновременно)

        await Auth.Logout();
        Nav.NavigateTo("login?expired=1");
    }

    // перезагрузить сайт целиком
    private void Reload() => Nav.NavigateTo(Nav.Uri, forceLoad: true);
}