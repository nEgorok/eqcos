@inject AuthService Auth

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">E.Q.C.O.S</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @if (Auth.Role != "Admin")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Запись
                </NavLink>
            </div>
        }

        @if (!Auth.IsLoggedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="register">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Регистрация
                </NavLink>
            </div>
        }

        @if (Auth.Role == "Admin")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Все записи
                </NavLink>
            </div>
        }
        @if (Auth.IsLoggedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="password">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Сменить пароль
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    // при входе/выходе перерисовать меню
    protected override void OnInitialized() => Auth.Changed += StateHasChanged;
}