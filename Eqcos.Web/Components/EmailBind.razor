@* привязка или смена почты: адрес → код из письма → готово.
   Используется в окне после регистрации (/welcome) и в профиле («Настройки аккаунта») *@
@inject HttpClient Http
@inject AuthService Auth

<div class="eq-enter">
    @if (!sent)
    {
        <input class="form-control mb-2" type="email" placeholder="Почта, например ivanov@mail.ru" @bind="email" />
        @if (NeedPassword)
        {
            @* смена уже привязанной почты — только с текущим паролем *@
            <PasswordInput Class="mb-2" Placeholder="Текущий пароль" @bind-Value="password" />
        }
        <button class="btn btn-primary eq-submit @(Wide ? "w-100" : "")" @onclick="SendCode">Отправить код</button>
    }
    else
    {
        <div class="small mb-2">@info</div>
        <input class="form-control mb-2" placeholder="Код из письма" inputmode="numeric" maxlength="6" @bind="code" />
        <button class="btn btn-primary eq-submit @(Wide ? "w-100" : "")" @onclick="ConfirmCode">Подтвердить</button>
        <div class="mt-2">
            <button class="btn btn-link btn-sm p-0" @onclick="Back">Другой адрес или новый код</button>
        </div>
    }

    @if (error != null)
    {
        <div class="text-danger mt-2">@error</div>
    }
</div>

@code {
    [Parameter] public bool NeedPassword { get; set; }              // true — почта уже есть, это смена
    [Parameter] public bool Wide { get; set; }                      // кнопки во всю ширину (окно после регистрации)
    [Parameter] public EventCallback<string> OnDone { get; set; }   // почта привязана — сообщаем странице текст сервера

    private string email = "";
    private string password = "";
    private string code = "";
    private bool sent;        // код отправлен — показываем поле для кода
    private string? info;     // «Код отправлен на i***@mail.ru»
    private string? error;

    private async Task SendCode()
    {
        error = null;
        var resp = await Http.PostAsJsonAsync("api/email/send", new { email, password });
        var text = await resp.Content.ReadAsStringAsync();
        if (!resp.IsSuccessStatusCode)
        {
            error = text;   // «Неверный пароль», «уже привязана к другой учётной записи», «слишком много писем»
            return;
        }
        info = text;
        code = "";
        sent = true;
    }

    private async Task ConfirmCode()
    {
        error = null;
        var resp = await Http.PostAsJsonAsync("api/email/confirm", new { code });
        var text = await resp.Content.ReadAsStringAsync();
        if (!resp.IsSuccessStatusCode)
        {
            error = text;   // «Неверный код. Осталось попыток: 4»
            return;
        }

        await Auth.SetHasEmail();   // убрать напоминания в шапке и на главной
        sent = false;
        email = password = code = "";
        await OnDone.InvokeAsync(text);
    }

    // вернуться к вводу адреса (адрес остаётся в поле — можно исправить или отправить код ещё раз)
    private void Back()
    {
        sent = false;
        error = null;
    }
}