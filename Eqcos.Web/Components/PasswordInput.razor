@* поле пароля с глазиком: нажал — пароль видно, нажал ещё раз — снова точки *@
<div class="eq-pass @Class">
    <input class="form-control"
           type="@(show ? "text" : "password")"
           placeholder="@Placeholder"
           value="@Value"
           @oninput="OnInput" />
    <button type="button" class="eq-eye" title="@(show ? "Скрыть пароль" : "Показать пароль")"
            @onclick="() => show = !show">
        @(show ? "🙈" : "👁")
    </button>
</div>

@code {
    // Value + ValueChanged — пара, которая позволяет писать @bind-Value="password"
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Пароль";
    [Parameter] public string Class { get; set; } = "";   // отступы снаружи, например "mb-2"

    private bool show;   // показывать ли пароль

    // на каждую букву сообщаем странице новое значение
    private async Task OnInput(ChangeEventArgs e)
    {
        await ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
    }
}